# ==============================================
# GoFinVisor Configuration
# ==============================================

# ----------------------------------------------
# 1. Application Settings
# ----------------------------------------------
APP_NAME=GoFinVisor
APP_ENV=development          # development, staging, production
APP_PORT=8080
APP_VERSION=1.0.0
DEBUG=true

# ----------------------------------------------
# 2. Security (CRITICAL)
# ----------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION=24h
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ----------------------------------------------
# 3. Database Configuration
# ----------------------------------------------
# Driver: sqlite, postgres, mysql
DB_DRIVER=sqlite
DB_NAME=finance.db

# PostgreSQL Configuration (Production)
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gofinvisor
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL_MODE=disable
# TIMESCALE_ENABLED=true

# ----------------------------------------------
# 4. Market Data APIs (Free Tiers)
# ----------------------------------------------

# Binance (Crypto) - Free WebSocket
BINANCE_WS_ENABLED=true
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_SYMBOLS=btcusdt,ethusdt,bnbusdt,solusdt,adausdt

# Yahoo Finance (Stocks) - Free
YAHOO_FINANCE_ENABLED=true
YAHOO_SYMBOLS=AAPL,GOOGL,MSFT,SPY,THYAO.IS
YAHOO_FETCH_INTERVAL=15m

# Alpha Vantage (Optional Backup)
ALPHA_VANTAGE_API_KEY=demo

# Exchange Rates (Forex)
EXCHANGE_RATE_API_KEY=your_free_key_here

# ----------------------------------------------
# 5. Redis Configuration (Caching)
# ----------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----------------------------------------------
# 6. Notification Services
# ----------------------------------------------
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=GoFinVisor <noreply@gofinvisor.com>

# ----------------------------------------------
# 7. Server Configuration
# ----------------------------------------------
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# ----------------------------------------------
# 8. Logging
# ----------------------------------------------
LOG_LEVEL=info              # debug, info, warn, error
LOG_FORMAT=json             # json, text